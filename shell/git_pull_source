rk1828_sdk_project_pull()
{
    repo_dir="$CODE_BASE/arm64/rockchip/rk1828_sdk"

    if ! command -v repo >/dev/null 2>&1; then
        echo "ERROR: 找不到 repo 命令"
        return 1
    fi

    if [ ! -d "$repo_dir/.repo" ]; then
        echo "ERROR: 不是有效的 repo 工作区: $repo_dir"
        return 1
    fi

    print_line
    echo "     Start project-by-project pull rk1828-sdk"
    print_line
    cd "$repo_dir" || return 1

    # repo forall 在每个 manifest 项目目录执行原来的 stash/fetch/pull/pop 流程。
    repo forall --abort-on-errors -c '
        project="$REPO_PATH"
        remote="$REPO_REMOTE"
        stash_before=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)

        echo "[$project] stash"
        if ! git stash push --include-untracked -m "git_pull_source: rk1828:$project"; then
            echo "[$project] ERROR: git stash 失败"
            exit 1
        fi
        stash_after=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)

        restore_stash()
        {
            if [ "$stash_after" != "$stash_before" ]; then
                echo "[$project] stash pop"
                git stash pop || return 1
            fi
        }

        echo "[$project] git fetch $remote"
        if ! git fetch "$remote"; then
            echo "[$project] ERROR: git fetch 失败"
            restore_stash || true
            exit 1
        fi

        echo "[$project] git pull --ff-only"
        if ! git pull --ff-only; then
            echo "[$project] ERROR: git pull 失败"
            restore_stash || true
            exit 1
        fi

        if ! restore_stash; then
            echo "[$project] ERROR: stash pop 冲突；原修改仍保留在 stash 中"
            exit 1
        fi
    ' || {
        echo "ERROR: 至少一个项目同步失败；没有执行 reset 或 force-sync"
        return 1
    }

    print_line
    echo "   Finished project-by-project pull rk1828-sdk"
    print_line
}



