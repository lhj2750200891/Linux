# =========================================================
# 公共函数：执行一个仓库的更新流程
# 参数：
#   $1 = 显示名称
#   $2 = 仓库路径
#   $3 = 可选：切换分支，如 firefly-6.18，没有则传空字符串
#   $4 = 可选：remote 名称，如 firefly-linux，没有则用默认 fetch/pull
#   $5 = 可选：ff 合并到的远端分支，如 firefly-linux/rk356x/firefly-5.10。
#        SDK 压缩包解出来的仓库一般是游离提交（detached HEAD），git pull 会
#        报"not currently on a branch"，传入此参数后改用
#        git merge --ff-only <远端分支> 实现等效的 pull
# =========================================================
update_code()
{
    name="$1"
    repo_dir="$2"
    branch="$3"
    remote="$4"
    merge_ref="$5"

    print_line
    echo "     Start update $name"
    print_line

    echo "<1> enter $name dir"
    cd "$repo_dir" || {
        echo "ERROR: 无法进入目录: $repo_dir"
        return 1
    }

    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "ERROR: 不是可用的 git 仓库: $repo_dir"
        echo "       （若 .git 是指向 .repo/projects/xxx 的失效软链接，"
        echo "         需先恢复 .repo 目录或重新同步代码，才能执行 pull）"
        return 1
    fi

    stash_before=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)
    echo "<2> git stash"
    if ! git stash push --include-untracked -m "git_pull_source: $name"; then
        echo "ERROR: git stash 失败"
        return 1
    fi
    stash_after=$(git rev-parse -q --verify refs/stash 2>/dev/null || true)

    if [ -n "$branch" ]; then
        echo "<3> git switch $branch"
        if ! git switch "$branch"; then
            echo "ERROR: 无法切换分支: $branch"
            [ "$stash_after" != "$stash_before" ] && git stash pop >/dev/null 2>&1 || true
            return 1
        fi
    fi

    if [ -n "$remote" ]; then
        echo "<4> git fetch $remote"
        if ! git fetch "$remote"; then
            echo "ERROR: git fetch 失败"
            [ "$stash_after" != "$stash_before" ] && git stash pop >/dev/null 2>&1 || true
            return 1
        fi
    else
        echo "<4> git fetch"
        if ! git fetch; then
            echo "ERROR: git fetch 失败"
            [ "$stash_after" != "$stash_before" ] && git stash pop >/dev/null 2>&1 || true
            return 1
        fi
    fi

    if [ -n "$merge_ref" ]; then
        echo "<5> git merge --ff-only $merge_ref"
        if ! git merge --ff-only "$merge_ref"; then
            echo "ERROR: git merge --ff-only 失败"
            [ "$stash_after" != "$stash_before" ] && git stash pop >/dev/null 2>&1 || true
            return 1
        fi
    else
        echo "<5> git pull"
        if ! git pull --ff-only; then
            echo "ERROR: git pull 失败"
            [ "$stash_after" != "$stash_before" ] && git stash pop >/dev/null 2>&1 || true
            return 1
        fi
    fi

    if [ "$stash_after" != "$stash_before" ]; then
        echo "<6> git stash pop"
        if ! git stash pop; then
            echo "ERROR: stash pop 发生冲突，请手动处理"
            return 1
        fi
    fi

    print_line
    echo "   Finished update $name"
    print_line
    echo " "
    echo " "
    sleep 2
}

