		>;
		default-brightness-level = <200>;
	};
};

&pwm11 {
	pinctrl-0 = <&pwm11m3_pins>;
	status = "okay";
};

&mipi_dcphy1 {
	status = "okay";
};

&dsi1_in_vp3 {
	status = "okay";
};

&route_dsi1 {
	status = "okay";
	connect = <&vp3_out_dsi1>;
};

&dsi1 {
	status = "okay";
	//firefly-check;

	dsi1_panel: panel0@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight_1>;

		enable-gpios = <&pca9555 PCA_IO0_1 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_LOW>;

		enable-delay-ms = <50>;
		prepare-delay-ms = <200>;
		reset-delay-ms = <50>;
		init-delay-ms = <55>;
		unprepare-delay-ms = <50>;
		disable-delay-ms = <20>;
		mipi-data-delay-ms = <200>;
		size,width = <120>;
		size,height = <170>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;

		panel-read-id-sequence = [
			39 00 04 FF 98 81 01
		];
		id-reg = <0x00>;
		id = [98];

