#include "rk3588-firefly-common.dtsi"

/ {
#ifdef FF_LEDS
	firefly_leds: leds {
		status = "okay";
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&leds_gpio>;

		power_led: power {
			label = ":power"; //WORK_LED
			linux,default-trigger = "ir-power-click";
			default-state = "on";
			gpios = <&gpio1 RK_PB3 GPIO_ACTIVE_HIGH>;
		};

		user_led: user {
			label = ":user"; //DIY_LED
			linux,default-trigger = "ir-user-click";
			default-state = "off";
			gpios = <&pca9555 PCA_IO0_3 GPIO_ACTIVE_HIGH>;
		};
	};
#endif

#ifdef FF_SDCARD
	vcc_sdcard_pwr_en: vcc-sdcard-pwr-en-regulator {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc_sdcard_pwr_en";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9555 PCA_IO1_5 GPIO_ACTIVE_HIGH>;
	};
#endif

#ifdef FF_USB20_HOST1
	vcc_hub_reset: vcc-hub-reset-regulator {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc_hub_reset";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9555 PCA_IO0_4 GPIO_ACTIVE_HIGH>;
	};
#endif

#ifdef FF_USB30
	vcc5v0_usb30: vcc5v0-usb30 {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb30";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pca9555 PCA_IO0_7 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_hub3_reset: vcc-hub3-reset-regulator {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc_hub3_reset";
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9555 PCA_IO0_6 GPIO_ACTIVE_HIGH>;
	};
#endif

#ifdef FF_ES8388
	es8388_sound: es8388-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-es8388";
		hp-det-gpio = <&gpio1 RK_PC4 GPIO_ACTIVE_LOW>;	//HP_DET_L
		io-channels = <&saradc 3>;
		io-channel-names = "adc-detect";
		poll-interval = <100>;
		spk-con-gpio = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;	//SPK_CTL_H -> XA9221
		hp-con-gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;	//PHONE_CTL
		rockchip,pre-power-on-delay-ms = <30>;
		rockchip,post-power-down-delay-ms = <40>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s0_8ch>;
		rockchip,codec = <&es8388>;
		ff-separate-headphone-jack;
		rockchip,audio-routing =
			"Headphone", "LOUT1",
			"Headphone", "ROUT1",
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Headphone", "Headphone Power",
			"Headphone", "Headphone Power",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"LINPUT1", "Main Mic",		// Line in L
			"RINPUT1", "Main Mic",		// Line in R
			"LINPUT2", "Headset Mic",	// Diff
			"RINPUT2", "Headset Mic";	// Diff
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		play-pause-key {
			label = "playpause";
			linux,code = <KEY_PLAYPAUSE>;
			press-threshold-microvolt = <2000>;
		};
	};
#endif

#ifdef FF_WIFI_BT
	wireless_bluetooth: wireless-bluetooth {
		status = "okay";
		compatible = "bluetooth-platdata";
		clocks = <&hym8563>;			/* BT 32.768k 时钟由 hym8563 提供 */
		clock-names = "ext_clock";
		uart_rts-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart6m1_rtsn>, <&bt_reset_gpio>, <&bt_wake_gpio>, <&bt_irq_gpio>;
		pinctrl-1 = <&uart6_gpios>;
		BT,power-gpios     = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;	//BT_REG_ON
		BT,wake-gpios      = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;	//BT_WAKE
		BT,wake_host-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;	//BT_HOST_WAKE
	};

	wireless_wlan: wireless-wlan {
		status = "okay";
		compatible = "wlan-platdata";
		wifi_chip_type = "ap6275p";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren_gpio>;
		WIFI,poweren-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_HIGH>;	//WIFI_REG_ON
	};
#endif

#ifdef FF_TYPEC_FULL
	vbus5v0_typec_pwr_en: vbus5v0-typec-pwr-en-regulator {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec_pwr_en";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pca9555 PCA_IO1_4 GPIO_ACTIVE_HIGH>;	//TYPEC5V_PWREN_H
		vin-supply = <&vcc5v0_sys>;
	};
#endif

#ifdef FF_FAN
	fan: pwm-fan {
		status = "okay";
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		fan-supply = <&vcc12v_dcin>;		//12V (L4 电感)
		pwms = <&pwm15 0 50000 0>;
		cooling-levels = <0 50 100 150 200 255>;
		rockchip,temp-trips = <
			50000   1
			55000   2
			60000   3
			65000   4
			70000   5
		>;
	};
#endif

#ifdef FF_4G_5G_MODULE
	vcc3v8_4g: vcc3v8-4g {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_4g";
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9555 PCA_IO0_0 GPIO_ACTIVE_HIGH>;	//4G_PWR_EN
		vin-supply = <&vcc12v_dcin>;			//VCC_12V_EXT
	};

	bt_sco: bt-sco {
		status = "okay";
		compatible = "delta,dfbmcs320";
		#sound-dai-cells = <1>;
	};

	bt_sound: bt-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "dsp_a";
		simple-audio-card,bitclock-inversion = <0>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,bt";
		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&bt_sco 1>;
		};
	};
#endif

#ifdef FF_VGA
	dp1_sound: dp1-sound {
		status = "okay";
		compatible = "rockchip,hdmi";
		rockchip,card-name = "rockchip-dp1";
		rockchip,mclk-fs = <512>;
		rockchip,cpu = <&spdif_tx5>;
		rockchip,codec = <&dp1 1>;
		rockchip,jack-det;
	};
#endif

#ifdef FF_HDMIRX
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Reserve 256MB memory for hdmirx-controller@fdee0000 */
		cma {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 (256 * 0x100000) 0x0 (256 * 0x100000)>;
			linux,cma-default;
		};
	};

	hdmiin_sound: hdmiin-sound {
		compatible = "rockchip,hdmi";
		rockchip,mclk-fs = <128>;
		rockchip,format = "i2s";
		rockchip,bitclock-master = <&hdmirx_ctrler>;
		rockchip,frame-master = <&hdmirx_ctrler>;
		rockchip,card-name = "rockchip,hdmiin";
		rockchip,cpu = <&i2s7_8ch>;
		rockchip,codec = <&hdmirx_ctrler 0>;
		rockchip,jack-det;
	};
#endif
};

#ifdef FF_SATA0
&vcc3v3_sata0 {
	gpio = <&pca9555 PCA_IO1_2 GPIO_ACTIVE_HIGH>;
};
#endif

#if defined(FF_USB20_HOST0) || defined(FF_USB20_HOST1)
&vcc5v0_usb20_host0 {
	gpio = <&pca9555 PCA_IO0_5 GPIO_ACTIVE_HIGH>;
};
#endif

#ifdef FF_USB30
&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	status = "okay";
	dr_mode = "host";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
	phy-supply = <&vcc5v0_usb30>;
};

&usbdp_phy1 {
	status = "okay";
};
#endif

#ifdef FF_GMAC0
&gmac0_tx_bus2 {
	rockchip,pins =
		/* gmac0_txd0 */
		<2 RK_PB6 1 &pcfg_pull_up_drv_level_6>,
		/* gmac0_txd1 */
		<2 RK_PB7 1 &pcfg_pull_up_drv_level_6>,
		/* gmac0_txen */
		<2 RK_PC0 1 &pcfg_pull_none>;
};

&gmac0_rgmii_bus {
	rockchip,pins =
		/* gmac0_rxd2 */
		<2 RK_PA6 1 &pcfg_pull_none>,
		/* gmac0_rxd3 */
		<2 RK_PA7 1 &pcfg_pull_none>,
		/* gmac0_txd2 */
		<2 RK_PB1 1 &pcfg_pull_up_drv_level_6>,
		/* gmac0_txd3 */
		<2 RK_PB2 1 &pcfg_pull_up_drv_level_6>;
};
#endif

#ifdef FF_GMAC1
&gmac1_tx_bus2 {
	rockchip,pins =
		/* gmac1_txd0 */
		<3 RK_PB3 1 &pcfg_pull_up_drv_level_6>,
		/* gmac1_txd1 */
		<3 RK_PB4 1 &pcfg_pull_up_drv_level_6>,
		/* gmac1_txen */
		<3 RK_PB5 1 &pcfg_pull_none>;
};

&gmac1_rgmii_bus {
	rockchip,pins =
		/* gmac1_rxd2 */
		<3 RK_PA2 1 &pcfg_pull_none>,
		/* gmac1_rxd3 */
		<3 RK_PA3 1 &pcfg_pull_none>,
		/* gmac1_txd2 */
		<3 RK_PA0 1 &pcfg_pull_up_drv_level_6>,
		/* gmac1_txd3 */
		<3 RK_PA1 1 &pcfg_pull_up_drv_level_6>;
};
#endif

#ifdef FF_RECOVERY_KEY
&adc_keys {
	recovery-key {
		label = "F12";
		linux,code = <KEY_F12>;
		press-threshold-microvolt = <10000>;
	};
};
#endif

#ifdef FF_ES8388
&i2c3 {
	status = "okay";

	es8388: es8388@11 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&mclkout_i2s0>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_i2s0>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_mclk>;
	};
};

&i2s0_8ch {
	status = "okay";
};
#endif

#ifdef FF_WIFI_BT
&uart6 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart6m1_xfer &uart6m1_ctsn>;
};

&combphy1_ps {
	status = "okay";
};

&pcie2x1l0 {
	status = "okay";
	reset-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;	//WIFI_PERST
	rockchip,skip-scan-in-resume;
};
#endif

#ifdef FF_TYPEC_FULL
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
	rockchip,typec-vbus-det;
};

&usbdp_phy0 {
	status = "okay";
	orientation-switch;
	mode-switch;
	svid = <0xff01>;
	sbu1-dc-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;	//TYPEC0_SBU1_DC
	sbu2-dc-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;	//TYPEC0_SBU2_DC

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdp_phy0_orientation_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdp_phy0_dp_altmode_mux: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp_altmode_mux>;
		};
	};
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	status = "okay";
	dr_mode = "otg";
	usb-role-switch;
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&dp0 {
	status = "okay";
};

&dp0_in_vp2 {
	status = "okay";
};
#endif

&i2c6 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6m0_xfer>;
	clock-frequency = <400000>;
#ifdef FF_PCA953X
	pca9555: gpio@21 {
		status = "okay";
		compatible = "nxp,pca9555";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-group-num = <200>;
		pinctrl-names = "default";
	};
#endif
	
#ifdef FF_RTC
	hym8563: hym8563@51 {
		status = "okay";
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;	//RTC_INT
		wakeup-source;
	};
#endif

#ifdef FF_SW3203
	sw3203@3c {
		status = "okay";
		compatible = "ismartware,sw3203";
		reg = <0x3c>;
		startup-delay-ms = <2500>;
		reg-0x20 = <0x05>;
	};
#endif

#ifdef FF_TYPEC_FULL
	usbc0: fusb302@22 {
		status = "okay";
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec_pwr_en>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos =
				<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
			source-pdos =
				<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;

			altmodes {
				#address-cells = <1>;
				#size-cells = <0>;

				altmode@0 {
					reg = <0>;
					svid = /bits/ 16 <0xff01>;
					vdo = <0x00001c46>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdp_phy0_orientation_switch>;
					};
				};

				port@1 {
					reg = <1>;
					dp_altmode_mux: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_altmode_mux>;
					};
				};
			};
		};
	};
#endif
};

#ifdef FF_FAN
&pwm15 {
	status = "okay";
	pinctrl-0 = <&pwm15m2_pins>;
};
#endif

#ifdef FF_CAN1
&can1 {
	status = "okay";
	assigned-clocks = <&cru CLK_CAN1>;
	assigned-clock-rates = <200000000>;
	pinctrl-0 = <&can1m1_pins>;
};
#endif

#ifdef FF_4G_5G_MODULE
&i2s1_8ch {
	status = "okay";
	pinctrl-0 = <&i2s1m0_lrck &i2s1m0_sclk &i2s1m0_sdi0 &i2s1m0_sdo0>;
	rockchip,bclk-fs = <32>;
};

&combphy2_psu {
	status = "okay";
};

&pcie2x1l1 {
	status = "okay";
};
#endif

#ifdef FF_RS232
&uart0 {
	pinctrl-0 = <&uart0m2_xfer>;
	status = "okay";
};
#endif

#ifdef FF_RS485
&uart1 {
	status = "okay";
};
#endif

#ifdef FF_VGA
&dp1_in_vp2 {
	status = "okay";
};

&dp1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&dp1_hpd>;
	hpd-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;	//VGA_HPDIN_L
};

&route_dp1 {
	status = "disabled";
	connect = <&vp2_out_dp1>;
};

/* lane2/3 给 dp1(IT6516), lane0/1 保持 USB3 */
&usbdp_phy1 {
	status = "okay";
	rockchip,dp-lane-mux = <2 3>;
};

&spdif_tx5 {
	status = "okay";
};
#endif

#ifdef FF_HDMIRX
&hdmirx_ctrler {
	status = "okay";
	#sound-dai-cells = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_rx &hdmirx_det>;
	/* Effective level used to trigger HPD: 0-low, 1-high */
	hpd-trigger-level = <1>;
	hdmirx-det-gpios = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;	//HDMIIRX_DET_L
};

&i2s7_8ch {
	status = "okay";
};
#endif

&pinctrl {
#ifdef FF_LEDS
	leds {
		leds_gpio: leds-gpio {
			rockchip,pins = <1 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_ES8388
	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_RTC
	rtc {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif

#ifdef FF_WIFI_BT
	wireless-bluetooth {
		uart6_gpios: uart6-gpios {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_reset_gpio: bt-reset-gpio {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio: bt-irq-gpio {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wireless-wlan {
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif

#ifdef FF_TYPEC_FULL
	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif

#ifdef FF_VGA
	dp {
		dp1_hpd: dp1-hpd {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_HDMIRX
	hdmirx {
		hdmirx_det: hdmirx-det {
			rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif
};

#ifdef FF_CAM_IMX415
/* ===== inlined from top-level dts: #include "rk3588-firefly-itx-3588j-mipi-csi0-imx415.dtsi" ===== */
// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/* MIPI CSI0 camera: 
 * I2C3_SDA_M0_MIPI ===> GPIO1 C1
 * I2C3_SCL_M0_MIPI ===> GPIO1 C0
 * MIPI_CAM3_PDN_L ===> GPIO1 A7
 * RESET0_CAM ===> GPIO1 B0
 * MIPI_CAM3_CLKOUT ===> GPIO1 D6
 * MIPI_CAM4_PWREN_H ===> GPIO1 B1
 * MIPI_CAM3_PWREN_H ===> GPIO1 B2
 * MIPI_CAM4_CLKOUT ===> GPIO1 D7
 * 
 * MIPI_CSI0_RX_D0P ===> rk3588: MIPI_CSI0_D0P
 * MIPI_CSI0_RX_D0N ===> rk3588: MIPI_CSI0_D0N
 * MIPI_CSI0_RX_D1P ===> rk3588: MIPI_CSI0_D1P
 * MIPI_CSI0_RX_D1N ===> rk3588: MIPI_CSI0_D1N
 * MIPI_CSI0_RX_D2P ===> rk3588: MIPI_CSI0_D2P
 * MIPI_CSI0_RX_D2N ===> rk3588: MIPI_CSI0_D2N
 * MIPI_CSI0_RX_D3P ===> rk3588: MIPI_CSI0_D3P
 * MIPI_CSI0_RX_D3N ===> rk3588: MIPI_CSI0_D3N
 * MIPI_CSI0_RX_CLK0P ===> rk3588: MIPI_CSI0_CLK0P
 * MIPI_CSI0_RX_CLK0N ===> rk3588: MIPI_CSI0_CLK0N
 * MIPI_CSI0_RX_CLK1P ===> rk3588: MIPI_CSI0_CLK1P
 * MIPI_CSI0_RX_CLK1N ===> rk3588: MIPI_CSI0_CLK1N
 */
 
&i2c3 {
	status = "okay";

	IMX415: imx415@37 {
		status = "okay";
		compatible = "sony,imx415";
		reg = <0x37>;
		clocks = <&cru CLK_MIPI_CAMARAOUT_M3>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&mipim0_camera3_clk>;
		power-domains = <&power RK3588_PD_VI>;

		reset-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
		pwdn-gpios = <&gpio1 RK_PA7 GPIO_ACTIVE_HIGH>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "CMK-OT2022-PX1";
		rockchip,camera-module-lens-name = "IR0147-50IRC-8M-F20";

		port {
			imx415_out: endpoint {
				remote-endpoint = <&mipidphy0_in_ucam1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			mipidphy0_in_ucam1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx415_out>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi2_csi2_input>;
			};
		};
	};
};

&mipi2_csi2 {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			mipi2_csi2_input: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi2_in0>;
			};
		};
	};
};

&rkcif_mipi_lvds2 {
	status = "okay";
	port {
		cif_mipi2_in0: endpoint {
			remote-endpoint = <&mipi2_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "okay";
	port {
		mipi_lvds2_sditf: endpoint {
			remote-endpoint = <&isp0_vir0>;
		};
	};
};

&rkisp0 {
	status = "okay";
};

&isp0_mmu {
	status = "okay";
};

&rkisp0_vir0 {
	status = "okay";
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		isp0_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds2_sditf>;
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mmu {
	status = "okay";
};
#endif

#if defined(FF_DSI0_V3) && !defined(FF_DSI1_V3)
/* ===== inlined from top-level dts: #include "rk3588-firefly-itx-3588j-mipi-dsi0.dtsi" ===== */
// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/* MIPI DSI0 disply: 
 * I2C1_SDA_M2_3V3 ===> I2C1_SDA_M2_TP ===> I2C1_SDA_M2
 * I2C1_SCL_M2_3V3 ===> I2C1_SCL_M2_TP ===> I2C1_SCL_M2
 * LCD0_PWR_EN ===> pca9555 IO 02
 * TP0_INT_L ===> GPIO3 C0
 * LCD0_BL_EN ===> GPIO2 C4
 * PWM12_M1 ===> GPIO4 B5
 * LCD0_RST ===> LCD_RESET_L(1.8V) ===> GPIO2 B4
 * TP0_RST_L ===> GPIO3 C1
 * 
 * MIPI_DPHY0_TX_D0P ===> rk3588: MIPI_DPHY0_TX_D0P
 * MIPI_DPHY0_TX_D0N ===> rk3588: MIPI_DPHY0_TX_D0N
 * MIPI_DPHY0_TX_D1P ===> rk3588: MIPI_DPHY0_TX_D1P
 * MIPI_DPHY0_TX_D1N ===> rk3588: MIPI_DPHY0_TX_D1N
 * MIPI_DPHY0_TX_D2P ===> rk3588: MIPI_DPHY0_TX_D2P
 * MIPI_DPHY0_TX_D2N ===> rk3588: MIPI_DPHY0_TX_D2N
 * MIPI_DPHY0_TX_D3P ===> rk3588: MIPI_DPHY0_TX_D3P
 * MIPI_DPHY0_TX_D3N ===> rk3588: MIPI_DPHY0_TX_D3N
 * MIPI_DPHY0_TX_CLKP ===> rk3588:  MIPI_DPHY0_TX_CLKP
 * MIPI_DPHY0_TX_CLKN ===> rk3588:  MIPI_DPHY0_TX_CLKN
 */
 
/ {
	backlight_0: backlight-0 {
		status = "okay";
		compatible = "pwm-backlight";
		enable-gpios = <&gpio2 RK_PC4 GPIO_ACTIVE_HIGH>;
		pwms = <&pwm12 0 50000 1>;
		brightness-levels = <
			 60  60  60  61  61  61  62  62
			 62  63  63  63  64  64  64  65
			 65  65  66  66  66  67  67  67
			 68  68  68  69  69  69  70  70
			 70  71  71  71  72  72  72  73
			 73  73  74  74  74  75  75  75
			 76  76  76  77  77  77  78  78
			 78  79  79  79  80  80  80  81
			 81  81  82  82  82  83  83  83
			 84  84  84  85  85  85  86  86
			 86  87  87  87  88  88  88  89
			 89  89  90  91  92  93  94  95
			 96  97  98  99 100 101 102 103
			104 105 106 107 108 109 110 111
			112 113 114 115 116 117 118 119
			120 121 122 123 124 125 126 127
			128 129 130 131 132 133 134 135
			136 137 138 139 140 141 142 143
			144 145 146 147 148 149 150 151
			152 153 154 155 156 157 158 159
			160 161 162 163 164 165 166 167
			168 169 170 171 172 173 174 175
			176 177 178 179 180 181 182 183
			184 185 186 187 188 189 190 191
			192 193 194 195 196 197 198 199
			200 201 202 203 204 205 206 207
			208 209 210 211 212 213 214 215
			216 217 218 219 220 221 222 223
			224 225 226 227 228 229 230 231
			232 233 234 235 236 237 238 239
			240 241 242 243 244 245 246 247
			248 249 250 251 252 253 254 255
		>;
		default-brightness-level = <200>;
	};
};

&pwm12 {
	pinctrl-0 = <&pwm12m1_pins>;
	status = "okay";
};

&mipi_dcphy0 {
	status = "okay";
};

&dsi0_in_vp3 {
	status = "okay";
};

&route_dsi0 {
	status = "okay";
	connect = <&vp3_out_dsi0>;
};

&dsi0 {
	status = "okay";
	//firefly-check;

	dsi0_panel: panel0@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight_0>;

		enable-gpios = <&pca9555 PCA_IO0_2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_LOW>;

		enable-delay-ms = <50>;
		prepare-delay-ms = <200>;
		reset-delay-ms = <50>;
		init-delay-ms = <55>;
		unprepare-delay-ms = <50>;
		disable-delay-ms = <20>;
		mipi-data-delay-ms = <200>;
		size,width = <120>;
		size,height = <170>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;
		
		panel-read-id-sequence = [
			39 00 04 FF 98 81 01
		];
		id-reg = <0x00>;
		id = [98];

		/* touch devices bound to this panel, fixed up together */
		rockchip,touch-nodes = <&goodix_ts>;

		panel-init-sequence = [
