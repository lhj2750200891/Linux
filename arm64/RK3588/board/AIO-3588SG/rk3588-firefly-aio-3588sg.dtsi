#include "rk3588-firefly-common.dtsi"

/ {
#ifdef FF_LEDS
	firefly_leds: leds {
		compatible = "gpio-leds";
		status = "okay";

		power_led: power {
			label = ":power";
			linux,default-trigger = "ir-power-click";
			default-state = "on";
			gpios = <&pca9555 PCA_IO1_7 GPIO_ACTIVE_HIGH>;
		};

		user_led: user {
			label = ":user";
			linux,default-trigger = "ir-user-click";
			default-state = "off";
			gpios = <&pca9555 PCA_IO1_6 GPIO_ACTIVE_HIGH>;
		};

		user_led1: user1 {
			label = ":user1";
			linux,default-trigger = "ir-user1-click";
			default-state = "off";
			gpios = <&pca9555 PCA_IO1_5 GPIO_ACTIVE_HIGH>;
		};
	};
#endif

#ifdef FF_FAN
	fan: pwm-fan {
		status = "okay";
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		fan-supply = <&vcc12v_dcin>;
		pwms = <&pwm15 0 50000 0>;
	};
#endif

#ifdef FF_SDCARD
	vcc3v3_sd_s0: vcc3v3-sd-s0 {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd_s0";
		enable-active-high;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&sd_pwr_en>;
		vin-supply = <&vcc_3v3_s3>;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
#endif

#ifdef FF_USB20_HOST0
	usb20_hub_reset: usb20-hub-reset {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "usb20_hub_reset";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9555 PCA_IO1_4 GPIO_ACTIVE_HIGH>;
	};
#endif

#if defined(FF_USB20_HOST0) || defined(FF_USB30_HOST)
	vcc5v0_usb_host: vcc5v0-usb-host {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb_host";
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_usb>;
	};
#endif

#ifdef FF_WIFIBT
	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&hym8563>;
		clock-names = "ext_clock";
		uart_rts-gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart9m2_rtsn>, <&bt_reset_gpio>, <&bt_wake_gpio>, <&bt_irq_gpio>;
		pinctrl-1 = <&uart9_gpio>;
		BT,reset-gpios      = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;  // BT_REG_ON
		BT,wake-gpios       = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;  // BT_WAKE_APB
		BT,wake_host-gpios  = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;  // BT_HOST_WAKE
		status = "okay";
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "ap6275p";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>, <&wifi_poweren_gpio>;
		WIFI,host_wake-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;  // WIFI_HOST_WAKE
		WIFI,poweren-gpios   = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;  // WL_REG_ON
		status = "okay";
	};

	bt_sco: bt-sco {
		status = "okay";
		compatible = "delta,dfbmcs320";
		#sound-dai-cells = <1>;
	};

	bt_sound: bt-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "dsp_a";
		simple-audio-card,bitclock-inversion = <0>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,bt";
		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};
		simple-audio-card,codec {
			sound-dai = <&bt_sco 1>;
		};
	};
#endif

#ifdef FF_CODEC_ES8388
	es8388_sound: es8388-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-es8388";
		//hp-det-gpio = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
		io-channels = <&saradc 4>;
		io-channel-names = "adc-detect";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;	
		spk-con-gpio = <&gpio1 RK_PC0 GPIO_ACTIVE_HIGH>;
		//hp-con-gpio = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&i2s0_8ch>;
		rockchip,codec = <&es8388>;
		rockchip,audio-routing =
			"Headphone", "LOUT1",
			"Headphone", "ROUT1",
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Headphone", "Headphone Power",
			"Headphone", "Headphone Power",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"LINPUT1", "Main Mic",
			"LINPUT2", "Main Mic",
			"RINPUT1", "Headset Mic",
			"RINPUT2", "Headset Mic";
		//pinctrl-names = "default";
		//pinctrl-0 = <&hp_det>;
		play-pause-key {
			label = "playpause";
			linux,code = <KEY_PLAYPAUSE>;
			press-threshold-microvolt = <2000>;
		};
	};
#endif

	charge_animation: charge-animation {
		status = "okay";
		compatible = "rockchip,uboot-charge";
		rockchip,uboot-charge-on = <1>;
		rockchip,android-charge-on = <0>;
		rockchip,uboot-exit-charge-level = <2>;
		rockchip,uboot-exit-charge-auto = <1>;
		rockchip,uboot-low-power-voltage = <6144>;
		rockchip,screen-on-voltage = <6144>;
	};
};

&vcc_3v3_s3 {
	regulator-state-mem {
		regulator-off-in-suspend;
	};
};

&vcc_3v3_s0 {
	regulator-state-mem {
		regulator-off-in-suspend;
		regulator-suspend-microvolt = <3300000>;
	};
};

&vcc_1v8_s0 {
	regulator-state-mem {
		regulator-off-in-suspend;
	};

};

&vcc5v0_sys{
	enable-active-high;
	gpio = <&gpio4 RK_PA0 GPIO_ACTIVE_HIGH>;
};

#ifdef FF_FAN
&pwm15 {
	status = "okay";
	pinctrl-0 = <&pwm15m2_pins>;
};
#endif

#ifdef FF_SDCARD
&sdmmc {
	status = "okay";
	vmmc-supply = <&vcc3v3_sd_s0>;
};
#endif

#ifdef FF_USB20_HOST0
&u2phy2_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host>;
};
#endif

#ifdef FF_USB30_HOST
&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb_host>;
};

&combphy2_psu {
	status = "okay";
};

&usbhost3_0 {
	status = "okay";
};

&usbhost_dwc3_0 {
	status = "okay";
	dr_mode = "host";
};
#endif

#ifdef FF_TYPEC0_FULL
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
	rockchip,typec-vbus-det;
};

&usbdp_phy0 {
	status = "okay";
	orientation-switch;
	mode-switch;
	svid = <0xff01>;
	sbu1-dc-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdp_phy0_orientation_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdp_phy0_dp_altmode_mux: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp_altmode_mux>;
		};
	};
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	status = "okay";
	dr_mode = "otg";
	usb-role-switch;
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&dp0 {
        status = "okay";
};

&dp0_in_vp2 {
	status = "okay";
};

&spdif_tx2{
        status = "okay";
};

&route_dp0 {
    status = "okay";
    connect = <&vp2_out_dp0>;
};

&dp0_sound{
        status = "okay";
};
#endif

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;

#ifdef FF_TYPEC0_FULL
	usbc0: fusb302@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
		int-n-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec_charge>;
		charge-dev = <&sc8886>;
		suspend-disable-irq;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos =
				<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
				 PDO_FIXED(9000, 3000, PDO_FIXED_USB_COMM)
				 PDO_FIXED(12000, 2000, PDO_FIXED_USB_COMM)>;
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			mode-switch = <&dp0>;

			altmodes {
				#address-cells = <1>;
				#size-cells = <0>;

				altmode@0 {
					reg = <0>;
					svid = /bits/ 16 <0xff01>;
					vdo = <0x00001c46>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdp_phy0_orientation_switch>;
					};
				};

				port@1 {
					reg = <1>;
					dp_altmode_mux: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_altmode_mux>;
					};
				};
			};
		};
	};
#endif

#ifdef FF_RTC
	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
		status = "okay";
	};
#endif
};

&i2c4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m3_xfer>;
	
#ifdef FF_PCA9555
	pca9555: gpio@21 {
		status = "okay";
		compatible = "nxp,pca9555";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-group-num = <200>;
	};
#endif

#ifdef FF_TYPEC0_FULL
	cw2017: cw2017@63 {
		status = "okay";
		compatible = "cellwise,cw2017";
		reg = <0x63>;
		cellwise,battery-profile = /bits/ 8
			<
			0x3C 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			0xB0 0xC4 0xBF 0xB9 0x9B 0x97 0xE0 0xCF
			0xC1 0xCD 0xBB 0x9D 0x88 0x7C 0x65 0x56
			0x52 0x50 0x4E 0x97 0x79 0xD2 0xDE 0xFF
			0xE5 0xB4 0x71 0x7C 0xB0 0xC5 0xAE 0x93
			0x9D 0xB5 0xCF 0xD5 0xC6 0xB0 0x99 0x89
			0x82 0x85 0x91 0xA8 0xC1 0xC9 0xB0 0x43
			0x00 0x00 0x90 0x02 0x00 0x00 0x00 0x00
			0x00 0x00 0x64 0x00 0x00 0x00 0x00 0x00
			0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xA2
			>;
		cellwise,dual-cell;
		cellwise,monitor-interval-ms = <5000>;
		cellwise,alert-level = <10>;
		cellwise,design-capacity-amh = <5000>;
		power-supplies = <&sc8886>;
		firefly,battery-max-voltage = <8400>;
		firefly,battery-min-voltage = <6000>;
		firefly,max-temp = <45>;
		firefly,min-temp = <10>;
	};
		
	sc8886: sc8886@6b {
		status = "okay";
		compatible = "ti,bq25703";
		reg = <0x6b>;
		ti,usb-charger-detection = <&usbc0>;
		ti,charge-current = <2000000>;
		interrupt-parent = <&gpio4>;
		interrupts = <RK_PC1 IRQ_TYPE_LEVEL_LOW>;
		otg-mode-en-gpios = <&gpio4 RK_PC0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_int>;
		extcon = <&u2phy0>;
		ti,max-input-voltage = <20000000>;
		ti,max-input-current = <6000000>;
		ti,max-charge-voltage = <8400000>;
		ti,input-current = <2500000>;
		ti,input-current-sdp = <2500000>;
		ti,input-current-dcp = <2500000>;
		ti,input-current-cdp = <2500000>;
		ti,minimum-sys-voltage = <6144000>;
		ti,otg-voltage = <5000000>;
		ti,otg-current = <1500000>;
		pd-charge-only = <0>;
		typec0-discharge-gpios = <&gpio1 RK_PA5 GPIO_ACTIVE_HIGH>;
		regulators {
			vbus5v0_typec_charge: vbus5v0-typec-charge {
				regulator-compatible = "otg-vbus";
				regulator-name = "vbus5v0_typec_charge";
			};
		};
	};
#endif

#ifdef FF_GSENSOR
	mc3230: mc3230@4c {
		status = "okay";
		compatible = "gs_mc3230";
		reg = <0x4c>;
		type = <SENSOR_TYPE_ACCEL>;
		irq_enable = <0>;
		poll_delay_ms = <30>;
		layout = <6>;
	};
#endif
};

&i2c7 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;

#ifdef FF_CODEC_ES8388
	es8388: es8388@11 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x11>;
		clocks = <&mclkout_i2s0>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_i2s0>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0_mclk>;
	};
#endif
};

#ifdef FF_GMAC1
&gmac1{
 	snps,reset-gpio = <&gpio1 RK_PA1 GPIO_ACTIVE_LOW>;
	tx_delay = <0x37>;
	status = "okay";
};
#endif

#if defined(FF_PCIE2_1L2) && !defined(FF_SATA0)
&pcie2x1l2 {
	reset-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
	rockchip,skip-scan-in-resume;
	status = "okay";
};
#endif


#ifdef FF_WIFIBT
&uart9 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart9m2_xfer &uart9m2_ctsn>;
};

&i2s1_8ch {
	status = "okay";
	pinctrl-0 = <&i2s1m0_lrck
		     &i2s1m0_sclk
		     &i2s1m0_sdi2
		     &i2s1m0_sdo3>;
	rockchip,bclk-fs = <32>;
};
#endif

#ifdef FF_CODEC_ES8388
&i2s0_8ch {
	status = "okay";
	pinctrl-0 = <&i2s0_sdi0 &i2s0_sdo0>;
};
#endif

#ifdef FF_CAN2
&can2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&can2m1_pins>;
};
#endif

#ifdef FF_UART
&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m2_xfer>;
};

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m2_xfer>;
};

&uart4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart4m0_xfer>;
};

&uart5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart5m1_xfer>;
};
#endif

&pinctrl {
#ifdef FF_SDCARD
	sdcard {
		sd_pwr_en: sd-pwr-en {
			rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
#endif

#ifdef FF_TYPEC0_FULL
	typec0 {
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		charger_int: charger-int {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif

#ifdef FF_RTC
	rtc {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
#endif

#ifdef FF_WIFIBT
	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wireless-bluetooth {
		uart9_gpio: uart9-gpio {
			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		bt_reset_gpio: bt-reset-gpio {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio: bt-wake-gpio {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio: bt-irq-gpio {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
#endif
};

#ifdef FF_EDP0_VP1
/* ===== inlined from top-level dts: #include "rk3588-firefly-aio-3588sg-edp0.dtsi" ===== */
// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2023 Rockchip Electronics Co., Ltd.
 *
 */

/ {
	vcc3v3_edp0_tp: vcc3v3-edp0-tp {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_edp0_tp";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9554 PCA_IO0_1 GPIO_ACTIVE_HIGH>;
	};

	edp0_tp_en: edp0-tp-en {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "edp0_tp_en";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&pca9554 PCA_IO0_2 GPIO_ACTIVE_HIGH>;
	};

	edp0_panel: edp0-panel {
		status = "okay";
		compatible = "simple-panel";
		backlight = <&backlight_edp0>;
		enable-gpios = <&pca9555 PCA_IO0_3 GPIO_ACTIVE_HIGH>;
		prepare-delay-ms = <200>;

		display-timings {
			native-mode = <&edp_timing0>;
			edp_timing0: timing0 {
				clock-frequency = <533250000>;  // Min 355.52 / Typ 533.25 / Max 586.6  (MHz)
				hactive = <3840>;
				vactive = <2160>;
				hfront-porch = <48>;
				hsync-len = <32>;
				hback-porch = <100>;
				vfront-porch = <3>;
				vsync-len = <5>;
				vback-porch = <30>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			panel_in_edp0: endpoint {
				remote-endpoint = <&edp0_out_panel>;
			};
		};
	};

	backlight_edp0: backlight-edp0 {
		status = "okay";
		compatible = "pwm-backlight";
		enable-gpios = <&pca9555 PCA_IO0_2 GPIO_ACTIVE_HIGH>; // EDP_BL_EN
