#ifdef FF_MIPI_CSI2_IMX415
/* ===== inlined from top-level dts: #include "rk3588-firefly-aio-3588sg-mipi-csi2-imx415.dtsi" ===== */
// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
