&dsi1 {
	status = "okay";
	/*
	 * firefly-check / 0x99 ID-check cmd are Firefly private features
	 * of the 6.1 BSP driver (panel-simple.c + dw-mipi-dsi2-rockchip.c);
	 * they are not ported to 6.12, keep them off here.
	 */
	//firefly-check;

	dsi1_panel: panel1@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight_1>;

		enable-gpios = <&pca9555 PCA_IO0_5 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pca9555 PCA_IO0_4 GPIO_ACTIVE_LOW>;

		enable-delay-ms = <50>;
		prepare-delay-ms = <200>;
		reset-delay-ms = <50>;
		init-delay-ms = <55>;
		unprepare-delay-ms = <50>;
		disable-delay-ms = <20>;
		mipi-data-delay-ms = <200>;
		size,width = <120>;
		size,height = <170>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;

		/*
		 * Panel presence check done by U-Boot: select page 1, then read
		 * register 0x00 and expect 0x98. When no MIPI panel is attached
		 * U-Boot disables this panel, its touch device, the dsi1
		 * controller and its route in the FDT passed to the kernel, so
		 * the kernel does not create a dead DSI connector that keeps
		 * the DRM component master deferred and blocks HDMI output.
		 * Same fix as ITX-3588J (commit 3270494f67d6).
		 */
		panel-read-id-sequence = [
			39 00 04 FF 98 81 01
		];
		id-reg = <0x00>;
		id = [98];

		/* touch device bound to this panel, disabled together */
		rockchip,touch-nodes = <&goodix_ts_dsi1>;

		panel-init-sequence = [
			39 00 04 FF 98 81 01
			39 00 04 FF 98 81 03
			15 00 02 01 00
			15 00 02 02 00
			15 00 02 03 55
			15 00 02 04 55
			15 00 02 05 03
			15 00 02 06 06
			15 00 02 07 00
