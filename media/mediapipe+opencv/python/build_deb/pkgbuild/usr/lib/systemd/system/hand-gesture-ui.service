[Unit]
Description=Firefly RK3588 Gesture Demo Launcher (ui/launcher.py)
Documentation=file:/home/firefly/hand_gesture/python/ui/README.md
# 与原 firefly-ui.desktop 等价: GDM 自动登录后, 在图形会话里常驻启动器
Wants=graphical.target
After=graphical.target

[Service]
Type=simple
User=firefly
Group=firefly
WorkingDirectory=/home/firefly/hand_gesture/python
# 与原 .desktop 的 Exec 一致: 虚拟环境 python 运行 ui/launcher.py
# 原方式为 while true; ... sleep 2 死循环, 此处等价改为 Restart=always
ExecStart=/home/firefly/hand_gesture/mediapipe_env/bin/python /home/firefly/hand_gesture/python/ui/launcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
