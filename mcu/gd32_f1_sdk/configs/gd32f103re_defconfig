# gd32f103re 板级默认配置 (make lunch BOARD=gd32f103re 选择本板)
# defconfig = 板卡的身份: 指定设备树 + 芯片 + 驱动裁剪
CONFIG_CHIP_GD32F103RE=y
CONFIG_BOARD_DTS=arm/boards/gd32f103re/gd32f103re.dts
CONFIG_DRIVER_SYSTICK=y
CONFIG_DRIVER_GPIO_GD32=y
CONFIG_DRIVER_LED=y
CONFIG_DRIVER_KEY=y
CONFIG_DRIVER_MATRIX_KEY=y
CONFIG_MATRIX_ROW_DELAY_MS=10
CONFIG_DRIVER_UART=y
CONFIG_DRIVER_UART_PRINTF=y
CONFIG_DRIVER_TIMER=y
