menu "驱动配置"
# 这里的 CONFIG_xxx 有两个作用:
#   1) C 代码层面: 生成 autoconf.h, 驱动/应用用 #ifdef CONFIG_xxx 条件编译
#   2) Make 层面: Makefile include .config, 通过 obj-$(CONFIG_xxx) 决定哪些驱动参与编译

config DRIVER_SYSTICK
	bool "SysTick 延时驱动 (设备树 systick 节点)"
	default y
	help
		  基于 Cortex-M3 内核 SysTick 的阻塞延时 (systick_init / sys_delay_us /
		  sys_delay_ms), CPU 时钟频率来自设备树 systick 节点的 clock-frequency。
		  key / matrix_key 的消抖扫描依赖本驱动提供的延时。

config DRIVER_GPIO_GD32
	bool "GD32 GPIO 核心驱动 (设备树驱动)"
	default y
	help
		  GD32F10x GPIO 的配置/读写/翻转驱动, 引脚信息全部来自设备树
		  (build/generated/devicetree_generated.h)。
		  是 led / key / matrix_key 驱动的基础, 关闭后它们也无法工作。

config DRIVER_LED
	bool "LED 驱动 (设备树 leds 节点)"
	default y
	depends on DRIVER_GPIO_GD32
	help
		  扫描设备树中 compatible = "gd,gpio-leds" 的节点, 生成 LED 实例表,
		  提供 led_set / led_toggle / LED1(x) 等接口。

config DRIVER_KEY
	bool "独立按键驱动 (设备树 keys 节点)"
	default y
	depends on DRIVER_GPIO_GD32
	depends on DRIVER_SYSTICK
	help
		  扫描设备树中 compatible = "gd,gpio-keys" 的节点, 提供按键消抖
		  扫描 key_scan() 与 KEY1~KEY4 读电平宏。

config DRIVER_MATRIX_KEY
	bool "矩阵键盘驱动 (设备树 matrix-keys 节点)"
	default y
	depends on DRIVER_GPIO_GD32
	depends on DRIVER_SYSTICK
	help
		  扫描设备树中 compatible = "gd,gpio-matrix-keys" 节点的
		  row-gpios / col-gpios, 提供逐行扫描 matrix_key_scan()。

config MATRIX_ROW_DELAY_MS
	int "矩阵扫描行切换延时 (ms)"
	default 10
	depends on DRIVER_MATRIX_KEY
	help
		  矩阵扫描拉低每一行后, 等待电平稳定的时间。
config DRIVER_UART
	bool "UART/USART 串口驱动 (设备树 uarts 节点)"
	default y
	depends on DRIVER_GPIO_GD32
	help
		  扫描设备树中 compatible = "gd,gd32-uart" 的 uarts 节点, 生成串口实例表。
		  每个实例支持三种工作模式(设备树 dma-mode/int-mode 属性):
		  纯轮询 / 中断(RBNE+IDLE) / DMA 收发(空闲中断判帧), printf 可重定向到
		  console=1 的实例。引脚可用 dtsi 预定义组(pgroup)或手动组合
		  (数据手册 2.6 节中标了 USARTx_TX/RX 的任意引脚)。

config DRIVER_UART_PRINTF
	bool "printf 重定向到 console 串口"
	default y
	depends on DRIVER_UART
	help
		  重定向 newlib 的 _write() 到设备树中 console=1 的 uart 实例,
		  应用层直接使用 printf 即可输出。

endmenu
