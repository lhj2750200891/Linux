# uart_echo 应用配置 (覆盖板级 configs/gd32f103re_defconfig)
# 本应用只需要串口 + systick, 裁掉 LED/按键/矩阵键盘
CONFIG_CHIP_GD32F103RE=y
CONFIG_BOARD_DTS=arm/boards/gd32f103re/gd32f103re.dts
CONFIG_DRIVER_SYSTICK=y
CONFIG_DRIVER_GPIO_GD32=y
CONFIG_DRIVER_UART=y
CONFIG_DRIVER_UART_PRINTF=y
# CONFIG_DRIVER_LED is not set
# CONFIG_DRIVER_KEY is not set
# CONFIG_DRIVER_MATRIX_KEY is not set
