/dts-v1/;

#include "gd32f103re.dtsi"

/ {
	model = "GD32F103RE generic board";
	compatible = "gd,gd32f103re-generic";

	leds {
		compatible = "gd,gpio-leds";
		status = "okay";
		count = <3>;              

		led1 {
			gpios = <&gpioc 13 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};

		led2 {
			gpios = <&gpioc 9 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};

		led3 {
			gpios = <&gpioc 8 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};
	};

	keys {
		compatible = "gd,gpio-keys";
		status = "okay";
		count = <4>;                     

		key1 {
			gpios = <&gpioa 7 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
		};

		key2 {
			gpios = <&gpioc 4 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
		};

		key3 {
			gpios = <&gpioc 5 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
		};

		key4 {
			gpios = <&gpioa 0 GD32_MODE_IPD>;
			active-level = <GD32_LEVEL_HIGH>;
		};
	};

	matrix-keys {
		compatible = "gd,gpio-matrix-keys";
		status = "okay";
		row-count = <4>;                    
		col-count = <3>;              

		row-gpios = <&gpioc 0 GD32_MODE_OUT_PP>,
			    <&gpioc 1 GD32_MODE_OUT_PP>,
			    <&gpioc 2 GD32_MODE_OUT_PP>,
			    <&gpioc 3 GD32_MODE_OUT_PP>;

		col-gpios = <&gpioa 4 GD32_MODE_IPU>,
			    <&gpioa 5 GD32_MODE_IPU>,
			    <&gpioa 6 GD32_MODE_IPU>;
	};

	uarts {
		compatible = "gd,gd32-uart";
		status = "okay";
		count = <3>;

		uart1 {
			pgroup = <&usart0 0>;
			baud-rate = <115200>;
			data-bits = <GD32_UART_DATA_8>;
			stop-bits = <GD32_UART_STOP_1>;
			parity = <GD32_UART_PM_NONE>;
			dma-mode = <1>;
			int-mode = <GD32_UART_INT_IDLE>;
			rx-pull = <0>;
			rx-buf-size = <128>;
			console = <1>;
		};

		uart2 {
			pgroup = <&usart1 0>;
		 	baud-rate = <9600>;
		 	dma-mode = <0>;
		 	int-mode = <GD32_UART_INT_RX_IDLE>;
		 	rx-buf-size = <64>;
		};
		 
		uart3 {
		 	tx-gpios = <&gpioc 10 GD32_MODE_AF_PP>;
		 	rx-gpios = <&gpioc 11 GD32_MODE_IN_FLOATING>;
		 	uart-idx = <2>;
		 	remap = <1>;
		 	dma-mode = <0>;
		 	int-mode = <GD32_UART_INT_NONE>;
		};
	};
};
