/dts-v1/;

#include "gd32f103re.dtsi"

/ {
	model = "GD32F103RE generic board";
	compatible = "gd,gd32f103re-generic";

	leds {
		compatible = "gd,gpio-leds";
		status = "okay";

		led1 {
			status = "okay";
			gpios = <&gpioc 13 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};

		led2 {
			status = "okay";
			gpios = <&gpioc 9 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};

		led3 {
			status = "okay";
			gpios = <&gpioc 8 GD32_MODE_OUT_PP>;
			init-level = <GD32_LEVEL_HIGH>;
		};
	};

	keys {
		compatible = "gd,gpio-keys";
		status = "okay";
		key-mode = <KEY_MODE_IRQ>;    /* EXTI 中断(默认); 轮询改 KEY_MODE_POLL + debounce-ms */

		key1 {
			status = "okay";
			gpios = <&gpioa 7 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
			trigger = <KEY_TRIG_FALLING>;   /* 低电平按下 -> 下降沿(默认) */
		};

		key2 {
			status = "okay";
			gpios = <&gpioc 4 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
		};

		key3 {
			status = "okay";
			gpios = <&gpioc 5 GD32_MODE_IPU>;
			active-level = <GD32_LEVEL_LOW>;
		};

		key4 {
			status = "okay";
			gpios = <&gpioa 0 GD32_MODE_IPD>;
			active-level = <GD32_LEVEL_HIGH>;   /* 高有效: 也可省略, 会按 IPD 推导 */
		};
	};

	basic-timers {
		compatible = "gd,gd32-basic-timer";
		status = "okay";

		btim1 {
			status = "okay";
			timer-idx = <5>;
			clock-hz = <108000000>;
			prescaler = <10800>;
			period-us = <500000>;
			irq-mode = <1>;
		};

		btim2 {
			status = "okay";
			timer-idx = <6>;
			clock-hz = <108000000>;
			prescaler = <10800>;
			period-us = <1000000>;
			irq-mode = <1>;
		};
	};

	/* 通用定时器 TIMER1~4: 四种模式 (mode) 详见 dt-bindings/timer/gd32f10x-timer.h
	 * 验证组合: TIMER2 PWM 输出 PB0 (CH2, 1kHz) --跳线--> TIMER3 双通道捕获 PB8
	 * (CH2 上升沿直连 + CH3 交叉下降沿, 共用 PB8 引脚; PB9 配了但不生效);
	 * TIMER1 做 1s 时基定时中断 (无引脚) */
	general-timers {
		compatible = "gd,gd32-general-timer";
		status = "okay";

		/* TIMER1: 1s 定时中断 (时基), prescaler=10800 -> 10kHz, 10000 tick */
		gtim1 {
			status = "okay";
			timer-idx = <1>;
			mode = <GD32_TIMER_MODE_TIMEBASE>;
			clock-hz = <108000000>;
			prescaler = <10800>;
			period-us = <1000000>;
			irq-mode = <1>;
		};

		/* TIMER2: PWM 输出, 1kHz/50%, CH2 -> PB0 (TIMER2 默认引脚组 CH2=PB0) */
		gtim2 {
			status = "okay";
			timer-idx = <2>;
			mode = <GD32_TIMER_MODE_PWM>;
			clock-hz = <108000000>;
			prescaler = <108>;          /* 1MHz, 1tick=1us */
			period-us = <1000>;          /* 1kHz */
			irq-mode = <0>;              /* pwm 不需要中断 */
			ch2 {
				channel = <2>;
				gpios = <&gpiob 0 GD32_MODE_AF_PP>;
				duty-tenk = <5000>;   /* 50% */
			};
		};

		/* TIMER3: 双通道测频+占空比, CH2/CH3 共用 PB8 引脚
		 * (CH2 直连上升沿, CH3 交叉下降沿)。
		 * prescaler=108 -> 1MHz 计数 (1tick=1us): 1kHz 周期=1000 tick,
		 * 16 位可测 15.3Hz~1MHz, 占空比分辨率 0.1% */
		gtim3 {
			status = "okay";
			timer-idx = <3>;
			mode = <GD32_TIMER_MODE_PWMCAP>;
			clock-hz = <108000000>;
			prescaler = <108>;           /* 1MHz 计数 */
			irq-mode = <0>;              /* 捕获差值在驱动 ISR 内计算, 应用轮询读结果 */
			ch2 {
				channel = <2>;
				gpios = <&gpiob 8 GD32_MODE_IPU>;
			};
			ch3 {
				channel = <3>;
				gpios = <&gpiob 9 GD32_MODE_IPU>;   /* pwmcap 高号通道引脚被忽略 */
			};
		};
	};

	matrix-keys {
		compatible = "gd,gpio-matrix-keys";
		status = "okay";
		row-count = <4>;                    
		col-count = <3>;              

		row-gpios = <&gpioc 0 GD32_MODE_OUT_PP>,
			    <&gpioc 1 GD32_MODE_OUT_PP>,
			    <&gpioc 2 GD32_MODE_OUT_PP>,
			    <&gpioc 3 GD32_MODE_OUT_PP>;

		col-gpios = <&gpioa 4 GD32_MODE_IPU>,
			    <&gpioa 5 GD32_MODE_IPU>,
			    <&gpioa 6 GD32_MODE_IPU>;
	};

	uarts {
		compatible = "gd,gd32-uart";
		status = "okay";

		uart1 {
			status = "okay";
			pgroup = <&usart0 0>;
			baud-rate = <115200>;
			data-bits = <GD32_UART_DATA_8>;
			stop-bits = <GD32_UART_STOP_1>;
			parity = <GD32_UART_PM_NONE>;
			dma-mode = <1>;
			int-mode = <GD32_UART_INT_IDLE>;
			rx-pull = <0>;
			rx-buf-size = <128>;
			console = <1>;
		};

		/* USART1: PA2/PA3, 115200, DMA 收 + IDLE 判帧 (RX=DMA0_CH5, TX=CH6) */
		uart2 {
			status = "okay";
			pgroup = <&usart1 0>;
			baud-rate = <115200>;
			data-bits = <GD32_UART_DATA_8>;
			stop-bits = <GD32_UART_STOP_1>;
			parity = <GD32_UART_PM_NONE>;
			dma-mode = <1>;
			int-mode = <GD32_UART_INT_IDLE>;
			rx-pull = <0>;
			rx-buf-size = <128>;
			console = <0>;
		};

		/* USART2: PB10/PB11, 115200, DMA 收 + IDLE 判帧 (RX=DMA0_CH2, TX=CH1)
		 * 不用时改 status = "disabled" 即可, uart1/uart2 的下标不受影响 */
		uart3 {
			status = "okay";
			pgroup = <&usart2 0>;
			baud-rate = <115200>;
			data-bits = <GD32_UART_DATA_8>;
			stop-bits = <GD32_UART_STOP_1>;
			parity = <GD32_UART_PM_NONE>;
			dma-mode = <1>;
			int-mode = <GD32_UART_INT_IDLE>;
			rx-pull = <0>;
			rx-buf-size = <128>;
			console = <0>;
		};
	};

	/* ------------------------------------------------------------------
	 * I2C 总线 (主机模式): i2c0 -> PB6=SCL/PB7=SDA, 100kHz
	 * 挂载的从机设备 = i2c0 的子节点, 仿 Linux: reg = 7 位从机地址,
	 * 每个从机有独立 status 开关; 应用用 oled0 -> DT_OLED0_IDX 访问
	 * ------------------------------------------------------------------ */
	i2c-buses {
		compatible = "gd,gd32-i2c";
		status = "okay";

		i2c0 {
			status = "okay";
			pgroup = <&i2c0grp 0>;
			speed = <GD32_I2C_SPEED_STANDARD>;   /* 100kHz; 400k 改 FAST */
			/* own-addr = <0x00>;   本机作从机时才有意义, 主机模式不用 */

			/* SSD1306 0.96 寸 OLED, 7 位地址 0x3C (模块常见 0x3C/0x3D) */
			oled0: oled0@3c {
				status = "okay";
				reg = <0x3c>;
				compatible = "sinowealth,ssd1306";
			};

			/* 一主多从示例: 第二个从机 (LM75 温度传感器 @0x48)。
			 * 不焊时 status = "disabled" 即可, 不影响 oled0, 应用引用
			 * DT_SENSOR1_IDX 会得到哨兵值, 驱动 API 安全空操作。
			sensor1: sensor1@48 {
				status = "okay";
				reg = <0x48>;
				compatible = "national,lm75";
			}; */
		};
	};

	/* ------------------------------------------------------------------
	 * SPI 总线 (主机模式): spi1 -> PB13=SCK/PB14=MISO/PB15=MOSI
	 * 片选 = 软 CS (cs-gpios 列表), 从机节点 reg = 列表下标 (仿 Linux);
	 * 测试应用 spi_test 需跳线 PB15(MOSI)-->PB14(MISO) 做回环自发自收
	 * ------------------------------------------------------------------ */
	spi-buses {
		compatible = "gd,gd32-spi";
		status = "okay";

		spi1 {
			status = "okay";
			pgroup = <&spi1grp 0>;
			baud-hz = <9000000>;                  /* 目标 SCLK, 驱动自动就近降档 */
			frame-size = <GD32_SPI_FRAME_8BIT>;
			cpol = <GD32_SPI_CPOL_LOW>;
			cpha = <GD32_SPI_CPHA_1EDGE>;         /* 0/0 = SPI MODE0 */
			first-bit = <GD32_SPI_FIRST_MSB>;

			/* 片选 GPIO 列表 (空闲高电平, 传输期间拉低) */
			cs-gpios = <&gpiob 12 GD32_MODE_OUT_PP>,
				   <&gpiob 1  GD32_MODE_OUT_PP>;

			/* 回环测试从机: CS=PB12, 配合 MOSI->MISO 跳线自发自收 */
			spidev0: spidev0@0 {
				status = "okay";
				reg = <0>;
				compatible = "gd,spi-loopback";
			};

			/* 一主多从示例: 第二个从机挂同一总线, 用 cs-gpios[1]=PB1 片选
			spidev1: spidev1@1 {
				status = "okay";
				reg = <1>;
			}; */
		};
	};
};
