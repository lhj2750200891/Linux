CONFIG_DRIVER_SYSTICK=y
CONFIG_DRIVER_GPIO_GD32=y
CONFIG_DRIVER_LED=y
CONFIG_DRIVER_KEY=y
CONFIG_KEY_DEBOUNCE_MS=20
CONFIG_DRIVER_MATRIX_KEY=y
CONFIG_MATRIX_ROW_DELAY_MS=10
